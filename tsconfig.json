{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "adapters/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "eval/**/*.ts"]
}
